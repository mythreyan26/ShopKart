# ShopKart Environment Variables
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
ALLOWED_HOSTS=.onrender.com,.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
